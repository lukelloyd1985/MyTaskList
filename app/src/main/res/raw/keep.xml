<?xml version="1.0" encoding="utf-8"?>
<!--
  default_web_client_id is only ever read at runtime via
  Resources#getIdentifier (see LoginScreen.kt's webClientIdOrNull) so that
  the app still compiles before Google sign-in is enabled in Firebase
  Console. Release builds have shrinkResources on, and its static analysis
  can't see that reflection-based lookup, so without this it silently
  strips the resource from release APKs - sign-in still works in debug
  builds (no shrinking there), which is what makes this easy to miss.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@string/default_web_client_id" />
