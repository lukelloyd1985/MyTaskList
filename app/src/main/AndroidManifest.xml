<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".MyTasksApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyTasks"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MyTasks">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Appwrite OAuth2 browser-redirect callback - see
             AuthRepository.signInWithGoogle and appwriteCallbackScheme in
             app/build.gradle.kts. The callback intent-filter must be
             declared on the SDK's own io.appwrite.views.CallbackActivity,
             not on an app Activity: that class is what routes the redirect
             to WebAuthComponent.onCallback(), which is `internal` to the
             SDK module and unreachable from app code. The SDK's own
             AndroidManifest.xml doesn't declare this activity itself (no
             manifest merger registers it automatically), so every
             consuming app must add this block explicitly - confirmed
             against github.com/appwrite/sdk-for-android's
             example/src/main/AndroidManifest.xml and
             library/.../views/CallbackActivity.kt. Originally (incorrectly)
             attached to .MainActivity with launchMode="singleTask" instead. -->
        <activity
            android:name="io.appwrite.views.CallbackActivity"
            android:exported="true">
            <intent-filter android:label="android_web_auth">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${appwriteCallbackScheme}" />
            </intent-filter>
        </activity>

        <service
            android:name=".notifications.MyTasksMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/notification_channel_tasks_id" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <!-- WorkManager is initialized on-demand from MyTasksApp with a
                 Hilt-aware WorkerFactory instead of its default initializer. -->
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
