# Copy to .env for local `firebase emulators:start`, or set these as
# Cloud Functions secrets/environment config for deployment:
#   firebase functions:secrets:set LINKEDIN_CLIENT_ID
#
# LinkedIn: create an app at https://www.linkedin.com/developers/apps,
# enable "Sign In with LinkedIn using OpenID Connect", and use its Client ID.
LINKEDIN_CLIENT_ID=

# Proton does not currently offer a self-serve OAuth/OIDC program for
# third-party consumer apps. These are left blank until you have been
# onboarded - see the main README's "Proton sign-in" section.
PROTON_ISSUER=
PROTON_JWKS_URI=
PROTON_CLIENT_ID=
