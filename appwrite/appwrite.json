{
  "projectId": "6a908cc500040c850f13",
  "projectName": "MyTasks",
  "databases": [
    {
      "$id": "mytasks",
      "name": "MyTasks",
      "enabled": true
    }
  ],
  "tables": [
    {
      "$id": "users",
      "$permissions": [
        "create(\"users\")",
        "read(\"users\")"
      ],
      "databaseId": "mytasks",
      "name": "users",
      "enabled": true,
      "rowSecurity": true,
      "columns": [
        {
          "key": "displayName",
          "type": "string",
          "required": false,
          "array": false,
          "size": 255,
          "default": null
        },
        {
          "key": "email",
          "type": "string",
          "required": false,
          "array": false,
          "size": 255,
          "default": null
        },
        {
          "key": "photoUrl",
          "type": "string",
          "required": false,
          "array": false,
          "size": 2048,
          "default": null
        },
        {
          "key": "locale",
          "type": "string",
          "required": false,
          "array": false,
          "size": 10,
          "default": null
        }
      ],
      "indexes": [
        {
          "key": "email_idx",
          "type": "key",
          "status": "available",
          "attributes": ["email"],
          "orders": ["ASC"]
        }
      ]
    },
    {
      "$id": "lists",
      "$permissions": [
        "create(\"users\")"
      ],
      "databaseId": "mytasks",
      "name": "lists",
      "enabled": true,
      "rowSecurity": true,
      "columns": [
        {
          "key": "name",
          "type": "string",
          "required": true,
          "array": false,
          "size": 255,
          "default": null
        },
        {
          "key": "icon",
          "type": "string",
          "required": false,
          "array": false,
          "size": 64,
          "default": null
        },
        {
          "key": "colorHex",
          "type": "string",
          "required": false,
          "array": false,
          "size": 16,
          "default": null
        },
        {
          "key": "visibility",
          "type": "enum",
          "required": false,
          "array": false,
          "elements": ["PRIVATE", "SHARED"],
          "default": "PRIVATE"
        },
        {
          "key": "ownerId",
          "type": "string",
          "required": true,
          "array": false,
          "size": 255,
          "default": null
        },
        {
          "key": "ownerName",
          "type": "string",
          "required": false,
          "array": false,
          "size": 255,
          "default": null
        },
        {
          "key": "memberIds",
          "type": "string",
          "required": false,
          "array": true,
          "size": 255,
          "default": null
        },
        {
          "key": "members",
          "type": "string",
          "required": false,
          "array": false,
          "size": 16384,
          "default": null
        }
      ],
      "indexes": [
        {
          "key": "ownerId_idx",
          "type": "key",
          "status": "available",
          "attributes": ["ownerId"],
          "orders": ["ASC"]
        }
      ]
    },
    {
      "$id": "tasks",
      "$permissions": [
        "create(\"users\")"
      ],
      "databaseId": "mytasks",
      "name": "tasks",
      "enabled": true,
      "rowSecurity": true,
      "columns": [
        {
          "key": "listId",
          "type": "string",
          "required": true,
          "array": false,
          "size": 255,
          "default": null
        },
        {
          "key": "title",
          "type": "string",
          "required": true,
          "array": false,
          "size": 512,
          "default": null
        },
        {
          "key": "description",
          "type": "string",
          "required": false,
          "array": false,
          "size": 4096,
          "default": null
        },
        {
          "key": "assigneeId",
          "type": "string",
          "required": false,
          "array": false,
          "size": 255,
          "default": null
        },
        {
          "key": "assigneeName",
          "type": "string",
          "required": false,
          "array": false,
          "size": 255,
          "default": null
        },
        {
          "key": "priority",
          "type": "enum",
          "required": false,
          "array": false,
          "elements": ["LOW", "MEDIUM", "HIGH"],
          "default": "MEDIUM"
        },
        {
          "key": "dueAt",
          "type": "datetime",
          "required": false,
          "array": false,
          "default": null
        },
        {
          "key": "notify",
          "type": "boolean",
          "required": false,
          "array": false,
          "default": false
        },
        {
          "key": "completed",
          "type": "boolean",
          "required": false,
          "array": false,
          "default": false
        },
        {
          "key": "order",
          "type": "integer",
          "required": false,
          "array": false,
          "min": -9223372036854775808,
          "max": 9223372036854775807,
          "default": 0
        },
        {
          "key": "createdBy",
          "type": "string",
          "required": false,
          "array": false,
          "size": 255,
          "default": null
        },
        {
          "key": "createdByName",
          "type": "string",
          "required": false,
          "array": false,
          "size": 255,
          "default": null
        },
        {
          "key": "reminderSent",
          "type": "boolean",
          "required": false,
          "array": false,
          "default": false
        }
      ],
      "indexes": [
        {
          "key": "listId_idx",
          "type": "key",
          "status": "available",
          "attributes": ["listId"],
          "orders": ["ASC"]
        },
        {
          "key": "assigneeId_idx",
          "type": "key",
          "status": "available",
          "attributes": ["assigneeId"],
          "orders": ["ASC"]
        },
        {
          "key": "notify_idx",
          "type": "key",
          "status": "available",
          "attributes": ["notify"],
          "orders": ["ASC"]
        },
        {
          "key": "completed_idx",
          "type": "key",
          "status": "available",
          "attributes": ["completed"],
          "orders": ["ASC"]
        },
        {
          "key": "reminderSent_idx",
          "type": "key",
          "status": "available",
          "attributes": ["reminderSent"],
          "orders": ["ASC"]
        },
        {
          "key": "list_completed_due_idx",
          "type": "key",
          "status": "available",
          "attributes": ["listId", "completed", "dueAt"],
          "orders": ["ASC", "ASC", "ASC"]
        },
        {
          "key": "notify_reminder_due_idx",
          "type": "key",
          "status": "available",
          "attributes": ["notify", "reminderSent", "dueAt"],
          "orders": ["ASC", "ASC", "ASC"]
        }
      ]
    }
  ],
  "functions": [
    {
      "$id": "notifications",
      "name": "notifications",
      "runtime": "node-22",
      "execute": [],
      "events": [
        "databases.mytasks.collections.tasks.documents.*.update"
      ],
      "scopes": [
        "databases.read",
        "databases.write",
        "documents.read",
        "documents.write",
        "messages.write"
      ],
      "schedule": "*/15 * * * *",
      "timeout": 60,
      "entrypoint": "dist/main.js",
      "commands": "npm install && npm run build",
      "specification": "s-0.5vcpu-512mb",
      "path": "functions/notifications"
    },
    {
      "$id": "maintenance",
      "name": "maintenance",
      "runtime": "node-22",
      "execute": [
        "any"
      ],
      "events": [
        "databases.mytasks.collections.lists.documents.*.update"
      ],
      "scopes": [
        "databases.read",
        "databases.write",
        "documents.read",
        "documents.write",
        "users.write"
      ],
      "schedule": "",
      "timeout": 60,
      "entrypoint": "dist/main.js",
      "commands": "npm install && npm run build",
      "specification": "s-0.5vcpu-512mb",
      "path": "functions/maintenance"
    }
  ]
}
