# Copy to .env (or export these directly in your shell) and fill in real
# values for a local run. Never commit a real .env - this file only
# documents the variable names, it holds no secrets.
#
# This script does not load .env itself (no dotenv dependency); either
# `export $(grep -v '^#' .env | xargs)` before running, or source it, or
# just set these in your shell/CI environment directly.

# --- Firestore (read side) ---

# Path to a Firebase service-account JSON key file (same convention as
# .github/workflows/deploy-firebase.yml's FIREBASE_SERVICE_ACCOUNT_JSON
# secret, decoded to a file). Grants firebase-admin read access via
# Application Default Credentials.
GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json

# Optional - defaults to "mytasks" (the named database this app has always
# used; see firebase.json / README "Creating the Firestore database").
FIRESTORE_DATABASE_ID=mytasks

# --- Appwrite (write side) ---

APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
# API key needs Databases (read/write) and Users (read/write) scopes.
APPWRITE_API_KEY=

# All optional - defaults shown match the finalized target schema.
APPWRITE_DATABASE_ID=mytasks
APPWRITE_COLLECTION_USERS_ID=users
APPWRITE_COLLECTION_LISTS_ID=lists
APPWRITE_COLLECTION_TASKS_ID=tasks
