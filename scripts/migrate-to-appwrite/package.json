{
  "name": "mytasklist-migrate-to-appwrite",
  "version": "1.0.0",
  "private": true,
  "description": "One-time migration of My Task List production data from Firestore (database \"mytasks\") to Appwrite Cloud.",
  "engines": {
    "node": ">=18"
  },
  "main": "dist/migrate.js",
  "scripts": {
    "build": "tsc",
    "migrate": "node dist/migrate.js",
    "migrate:dry-run": "node dist/migrate.js --dry-run"
  },
  "dependencies": {
    "firebase-admin": "^14.3.0",
    "node-appwrite": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.9.3"
  }
}
